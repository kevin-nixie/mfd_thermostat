FILE_TYPE=LIBRARY_PARTS;
PRIMITIVE 'CPC1966Y','CPC1966Y_Other';
  PIN
    '-LED':
      PIN_NUMBER='(1)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
    '+LED':
      PIN_NUMBER='(2)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
    'AC_LOAD_1':
      PIN_NUMBER='(3)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
    'AC_LOAD_2':
      PIN_NUMBER='(4)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
  END_PIN;
  BODY
    PART_NAME='CPC1966Y';
    PHYS_DES_PREFIX='K';
    NO_LOAD_CHECK='TRUE';
    PIN_COUNT='4';
    BODY_NAME='CPC1966Y';
    JEDEC_TYPE='CPC1966Y';
  END_BODY;
END_PRIMITIVE;
END.
